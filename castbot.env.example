# Copy this file to castbot.env and set the mode to 0600.
# Generate a key with: openssl rand -hex 32
# The session key is read only from this file, never from the process environment.
CASTBOT_SESSION_KEY=changeme
CASTBOT_ADDR=127.0.0.1:8080
CASTBOT_DB=data/castbot.db
# Optional. Empty starts a local echo runtime in this process.
# CASTBOT_RUNTIME_URL=http://127.0.0.1:8081
# Optional machine host. Leave unset to keep the local echo runtime.
# One shared image for every agent. The token stays in this file.
# CASTBOT_DO_TOKEN=
# CASTBOT_IMAGE=example.invalid/castbot-runtime:s04
# CASTBOT_PUBLIC_URL=https://castbot.example
# Comma-separated proxy addresses or CIDRs. Empty trusts only the connection address.
# CASTBOT_TRUSTED_PROXIES=
