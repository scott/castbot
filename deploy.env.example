# Copy this file to deploy.env in the repo root and set the mode to 0600.
# deploy.env is gitignored. Environment variables win over this file.
# Use your own host when you run the script. The values below are placeholders.
#
# The SSH key is not set here. ssh uses the agent or ~/.ssh/config.
# Put the server host key in the known hosts file before the first run.
# StrictHostKeyChecking stays yes.

# Placeholder address from the documentation range. Replace it locally.
DEPLOY_HOST=203.0.113.10
DEPLOY_USER=deploy
DEPLOY_APP_DIR=/opt/castbot
# Read on the server only to find the CASTBOT_IMAGE line.
DEPLOY_ENV_FILE=/etc/castbot/castbot.env
DEPLOY_PUBLIC_URL=https://castbot.example.com
DEPLOY_KEEP_RELEASES=5
DEPLOY_KNOWN_HOSTS=.deploy/known_hosts
DEPLOY_LOG=.deploy/deploy.log
